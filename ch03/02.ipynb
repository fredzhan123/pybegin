    "Chapter 03\n",
    "\n",
    "# 条件语句"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e79fbb11",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "x is negative\n",
      "The absolute value of x is: 3.0\n"
     ]
    }
   ],
   "source": [
    "x =  float(input(\"请输入一个数字: \"))\n",
    "\n",
    "abs_x = x\n",
    "\n",
    "if x > 0:\n",
    "    print(\"x is positive\")\n",
    "elif x == 0:\n",
    "    print(\"x is zero\")\n",
    "else:\n",
    "    print(\"x is negative\")\n",
    "    abs_x = -x\n",
    "\n",
    "print(\"The absolute value of x is:\", abs_x)"
   ]
  }
